{
  "name": "schoolgantt",
  "version": "1.0.0",
  "description": "Personal Gantt chart web application for managing school project tasks",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js,.ts --fix",
    "lint:check": "eslint src --ext .vue,.js,.ts",
    "format": "prettier --write src/**/*.{vue,js,ts,css,scss,md}",
    "format:check": "prettier --check src/**/*.{vue,js,ts,css,scss,md}",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist node_modules/.vite",
    "serve": "npm run build && npm run preview"
  },
  "keywords": [
    "gantt",
    "project-management",
    "vue",
    "timeline",
    "school",
    "tasks"
  ],
  "author": "SchoolGantt Team",
  "license": "MIT",
  "dependencies": {
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@stagewise/toolbar-vue": "^0.2.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.15.29",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/ui": "^3.1.4",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.20.0",
    "happy-dom": "^17.5.6",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "vue-tsc": "^1.8.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
